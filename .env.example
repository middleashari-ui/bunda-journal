# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Configuration
VITE_SUPABASE_URL="https://wjxpbacoidyhavrfwgfu.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_zj8Q-QrhI0q5Zv085RyLjA_mFyeSTNL"

# Ruang Iklan (/ads) — server-side only. Jangan pakai prefix VITE_.
# Token Meta disimpan terenkripsi di backend, bukan di file ini.
META_SYSTEM_USER_TOKEN=""
META_KEK=""
META_API_VERSION="v27.0"

# Midtrans (pembayaran)
# Server key = secret Cloudflare Pages. Jangan commit nilai aslinya.
MIDTRANS_SERVER_KEY=""
# Opsional (disarankan sejak Midtrans 28 Okt 2026): kunci verifikasi webhook.
# Kalau kosong, signature diverifikasi dengan MIDTRANS_SERVER_KEY (akun lama).
MIDTRANS_SIGNATURE_SECRET_KEY=""
# sandbox | production. Default production kalau kosong.
MIDTRANS_ENV="sandbox"
# Kill switch darurat: "true" mematikan /api/midtrans/charge & /api/upgrade.
PAYMENT_PAUSED="false"
# Build-time (client key aman tampil di browser; mode harus sama dengan server key).
VITE_MIDTRANS_CLIENT_KEY=""
VITE_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"


# Meta Pixel ID (Events Manager, 15-16 digit). Kosong = pixel nonaktif.
VITE_META_PIXEL_ID=

# Web Push (Worker cron bunda-reminder-cron). Private key hanya untuk Worker.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@bundajournal.my.id"
